# Converte resources/langs/*.json in un header C++ con array di byte
# (gli array evitano il limite di lunghezza delle stringhe letterali di MSVC)
file(GLOB files "${LANG_DIR}/*.json")
list(SORT files)
set(content "// GENERATO da cmake/EmbedLangs.cmake\n#pragma once\n#include <cstddef>\nnamespace embedded_langs {\n")
set(table "")
set(idx 0)
foreach(f ${files})
    get_filename_component(name ${f} NAME_WE)
    file(READ ${f} hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR bytes "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
    string(APPEND content "inline const unsigned char data_${idx}[] = {${arr}0x00};\n")
    string(APPEND table "    {\"${name}\", reinterpret_cast<const char*>(data_${idx}), ${bytes}},\n")
    math(EXPR idx "${idx} + 1")
endforeach()
string(APPEND content "struct Lang { const char* name; const char* data; size_t size; };\n")
string(APPEND content "inline const Lang all[] = {\n${table}};\n")
string(APPEND content "inline constexpr size_t count = ${idx};\n}\n")
file(WRITE ${OUT} "${content}")
